+"""Single-CTA small-route alignment; no CPU route reads and no E-by-E workspace."""
+
+import torch
+import triton
+import triton.language as tl
+from flaggems_vllm.ops.kimi_k3_metax.grouped_moe import _alignment as baseline_alignment
+
+
+@triton.jit
+def _align_small(
+    IDS,
+    SORTED,
+    EXPERTS,
+    TOTAL,
+    R: tl.constexpr,
+    E: tl.constexpr,
+    BM: tl.constexpr,
+    B: tl.constexpr,
+    EB: tl.constexpr,
+):
+    r = tl.arange(0, B)
+    raw = tl.load(IDS + r, r < R, EB - 1).to(tl.int32)
+    counts = tl.histogram(raw, EB)
+    e = tl.arange(0, EB)
+    counts = tl.where(e < E, counts, 0)
+    padded = tl.cdiv(counts, BM) * BM
+    raw_end = tl.cumsum(counts, 0)
+    pad_end = tl.cumsum(padded, 0)
+    raw_start = raw_end - counts
+    pad_start = pad_end - padded
+    total = tl.sum(padded, 0)
+    tl.store(TOTAL, total)
+    # Stable expert then route order. Sentinel keys sort behind all valid routes.
+    key = tl.where(r < R, raw * B + r, 0x7FFFFFFF)
+    key = tl.sort(key, descending=False)
+    owner = tl.minimum(key // B, EB - 1)
+    route = key % B
+    position = r - tl.gather(raw_start, owner, 0)
+    destination = tl.gather(pad_start, owner, 0) + position
+    tl.store(SORTED + destination, route, r < R)
+    tl.store(EXPERTS + destination // BM, owner, (r < R) & (position % BM == 0))
+    # Padding tails are disjoint from valid destinations; no clear/scatter race.
+    for j in range(BM - 1):
+        p = pad_start + counts + j
+        tl.store(SORTED + p, R, (e < E) & (j < padded - counts))
+
+
+def align_small(ids, block_m, experts, *, num_warps=4, record=None):
+    if (
+        ids.ndim != 2
+        or ids.shape[1] != 16
+        or not (2 <= ids.shape[0] <= 64)
+        or block_m != 16
+        or experts != 896
+    ):
+        return baseline_alignment(ids, block_m, experts)
+    if ids.dtype not in (torch.int32, torch.int64) or not ids.is_contiguous():
+        raise ValueError("Expected contiguous integer route IDs")
+    r = ids.numel()
+    cap = min(experts, r) + (r - min(experts, r)) // block_m
+    si = torch.empty(cap * block_m, dtype=torch.int32, device=ids.device)
+    ei = torch.empty(cap, dtype=torch.int32, device=ids.device)
+    total = torch.empty(1, dtype=torch.int32, device=ids.device)
+    obj = _align_small[(1,)](
+        ids,
+        si,
+        ei,
+        total,
+        r,
+        experts,
+        block_m,
+        triton.next_power_of_2(r),
+        triton.next_power_of_2(experts),
+        num_warps=num_warps,
+    )
+    if record is not None:
+        record.update(
+            n_regs=obj.n_regs,
+            n_spills=obj.n_spills,
+            shared=obj.metadata.shared,
+            sorted_capacity=si.numel(),
+            expert_capacity=ei.numel(),
+            workspace_bytes=sum(t.numel() * t.element_size() for t in (si, ei, total)),
+        )
+    return si, ei, total
