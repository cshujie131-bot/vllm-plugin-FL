+            x,
+            a,
+            sa,
+            gu,
+            si,
+            ei,
+            total,
+            768,
+            3584,
+            cap * bm,
+            r,
+            16,
+            bm,
+            bn1,
+            bk1,
+            1,
+            PACK_K=128,
+            MODE=2 if prepared["normal_flags"][0] else 1,
+            num_warps=w1,
+            num_stages=2,
+        )
+    if not fused_g1:
