+    stride_kv_bs,
+    stride_kv_block,
+    Block_table,
+    stride_bt_b,
+    Seq_lens,
+    Out,
+    stride_o_b,
+    stride_o_sq,
+    stride_o_h,
+    LSE,
+    PartialMax,
+    PartialSum,
+    ProbabilityLow,
+    Alpha,
+    MAX_CHUNKS: tl.constexpr,
+    SPLITS: tl.constexpr,
+    stride_lse_b,
+    stride_lse_h,
+    sm_scale,
+    SQ,
+    HQ: tl.constexpr,
+    DQK: tl.constexpr,
+    HEAD_DIM_V: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    HAVE_CAUSAL: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    K_TILE: tl.constexpr,
+    CAP: tl.constexpr,
+    COMPENSATE: tl.constexpr,
