+                G1=meta(first),
+                G2=meta(second),
+                G2_slices=slice_meta,
+                G1_fused_situ=fused_g1,
+                tiles=(bm, bn1, bk1, w1, bn2, w2, tail),
+                bounded_route_columns=down_width,
+                scratch_bytes=scratch.numel() * 2,
