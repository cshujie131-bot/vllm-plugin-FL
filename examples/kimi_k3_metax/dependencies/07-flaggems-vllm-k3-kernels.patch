+@triton.jit
+def _prefill_mma(
+    Q,
+    K,
+    V,
+    CQ,
+    CK,
+    O,
+    L,
+    H: tl.constexpr,
+    SCALE: tl.constexpr,
+    CAUSAL: tl.constexpr,
+    BQ: tl.constexpr,
+    BK: tl.constexpr,
+    COMP: tl.constexpr,
+    KT: tl.constexpr,
+    VT: tl.constexpr,
+    PM,
+    PS,
+    NQ,
+    SPLITS: tl.constexpr,
+    LSE_HEAD_MAJOR: tl.constexpr = False,
