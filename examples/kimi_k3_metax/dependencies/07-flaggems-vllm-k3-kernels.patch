+@triton.jit
+def _pv_long_kernel(
+    Cache,
+    stride_kv_token,
+    stride_kv_block,
+    Table,
+    stride_table,
+    Lengths,
+    PH,
+    PL,
+    A,
+    Partial,
+    H: tl.constexpr,
+    SPLITS: tl.constexpr,
+    MAX_CHUNKS: tl.constexpr,
+    BN: tl.constexpr,
+    FOLD: tl.constexpr,
+    CAP: tl.constexpr,
+    COMPENSATE: tl.constexpr,
+    VT: tl.constexpr,
+    FUSED: tl.constexpr,
+):
+    b = tl.program_id(0)
+    split = tl.program_id(1)
