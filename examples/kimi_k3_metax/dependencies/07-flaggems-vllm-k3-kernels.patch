+    total = tl.sum(denom * scale, 0)
+    result = tl.where(total > 0, numerator / total, 0)
+    tl.store(O + (b * H + h) * V + d, result.to(tl.bfloat16), d < V)
+    if tl.program_id(2) == 0:
