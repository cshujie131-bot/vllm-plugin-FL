+    dv = vblock * VT + tl.arange(0, VT)
+    nn = tl.arange(0, BK)
+    maximum = tl.full((BQ,), -float("inf"), tl.float32)
+    denom = tl.zeros((BQ,), tl.float32)
+    acc = tl.zeros((BQ, VT), tl.float32)
