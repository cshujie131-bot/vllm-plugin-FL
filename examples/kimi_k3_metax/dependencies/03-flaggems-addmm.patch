+def _k3_tp32_addmm_config(mat1, mat2, bias, out, alpha, beta):
+    """Measured U tiles for temporary-output or disjoint-input direct-write calls."""
+    M, K = mat1.shape
+    N = mat2.shape[1]
+    if not (
+        runtime.device.vendor_name == "metax"
+        and isinstance(M, int) and M in _K3_TP32_U_TILES
+        and (N, K) == (224, 3584)
