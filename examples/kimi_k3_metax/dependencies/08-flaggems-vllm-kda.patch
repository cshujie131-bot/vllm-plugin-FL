+        g,
+        A,
+        y,
+        g_bias,
+        lower_bound or 0.0,
+        beta,
+        threshold,
+        T,
+        H,
+        head_k_dim,
+        BD=next_power_of_2(head_k_dim),
+        HAS_BIAS=g_bias is not None,
+        USE_LOWER_BOUND=lower_bound is not None,
+    )
