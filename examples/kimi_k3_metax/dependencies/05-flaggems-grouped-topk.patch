+def _k3_grouped_topk(S,B,V,I,E:tl.constexpr,STRIDE:tl.constexpr,RENORM:tl.constexpr,FACTOR:tl.constexpr,BLOCK:tl.constexpr,SORT:tl.constexpr):
+    token=tl.program_id(0)
+    e=tl.arange(0,BLOCK)
