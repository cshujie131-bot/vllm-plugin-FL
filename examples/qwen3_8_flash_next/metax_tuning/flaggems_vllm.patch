+
+# Offline-validated launch profiles. Geometry misses retain the caller defaults.
+def _qsa_attention_profile(a):
+    return (
+        a["D"] == 256
+        and a["GROUP_SIZE"] == 3
+        and a["dtype"] == a["kv_dtype"] == "torch.bfloat16"
+    )
+
+
+def _ple_profile(a):
+    return (
+        a["channels"] == 10240
+        and a["width"] == 4
+        and a["dilation"] == 3
+        and a["dtype"] == "torch.bfloat16"
+    )
+
+
+def _ple_bt(a):
+    if not _ple_profile(a):
+        return a["BT"]
+    return 1 if a["tokens"] <= 2 else (4 if a["tokens"] <= 4 else 8)
+
+
+def _ple_bc(a):
+    if not _ple_profile(a):
+        return a["BC"]
+    if a["tokens"] == 1:
+        return 128
+    if a["tokens"] <= 4:
+        return 64
+    return 256 if a["tokens"] >= 32 else 128
+
+
+def _gdn_wy_profile(a):
+    return (
+        a["T"] >= 512
+        and a["H"] == 6
+        and a["Hg"] == 2
+        and a["K"] == a["V"] == 128
+        and a["varlen"]
+        and a["dtype"] == "torch.bfloat16"
+    )
+
+
+HEURISTICS_CONFIGS.update(
+    {
+        "qsa_attention_launch": {
+            "BLOCK_M": lambda a: (
+                max(a["BLOCK_M"], 16) if _qsa_attention_profile(a) else a["BLOCK_M"]
+            ),
+            "num_warps": lambda a: (
+                (4 if a["M"] <= 64 else 2)
+                if _qsa_attention_profile(a)
+                else a["num_warps"]
+            ),
+            "num_stages": lambda a: 1 if _qsa_attention_profile(a) else a["num_stages"],
+        },
+        "ple_conv_launch": {
+            "BT": _ple_bt,
+            "BC": _ple_bc,
+            "num_warps": lambda a: (
+                (2 if 1 < a["tokens"] <= 4 else 4)
+                if _ple_profile(a)
+                else a["num_warps"]
+            ),
+            "num_stages": lambda a: 1 if _ple_profile(a) else a["num_stages"],
+        },
+        "ple_state_launch": {
+            "num_warps": lambda a: 1 if _ple_profile(a) else a["num_warps"],
+            "num_stages": lambda a: 1 if _ple_profile(a) else a["num_stages"],
+        },
+        "gdn_wy_tiles": {
+            "BK": lambda a: 32 if _gdn_wy_profile(a) else a["BK"],
+            "BV": lambda a: (
+                32 if _gdn_wy_profile(a) and not a["explicit_block_v"] else a["BV"]
+            ),
+        },
+    }
