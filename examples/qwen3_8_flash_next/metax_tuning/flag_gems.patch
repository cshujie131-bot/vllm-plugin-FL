 }
+
+
+# Offline scan profiles. Only measured geometries opt in; other shapes keep defaults.
+def _topk_profile(a):
+    return a["N"] in (512, 2048, 8192, 17408, 17600) and a["K"] == 512 and a["dtype"] == torch.float32
+
+
+def _mean_profile(a):
+    return a["input_ptr"].dtype == torch.float32 and a["N"] in (128, 256, 2560)
+
+
+def _mean_tile(a):
+    if not _mean_profile(a):
+        return softmax_heur_tile_n_inner(a)
+    n, m = a["N"], a["M"]
+    if n <= 256:
+        return n
+    return 4096 if m <= 128 else (1024 if m <= 512 else 512)
+
+
+def _mean_warps(a):
+    if not _mean_profile(a):
+        return softmax_heur_num_warps_inner(a)
+    return 1
+
+
+def _mean_vec_profile(a):
+    return a["N"] == 4 and a["K"] == 2560 and a["dtype"] == torch.bfloat16
+
+
+HEURISTICS_CONFIGS["topk_launch"] = {
+    "FORCE_TWO_STAGE": _topk_profile,
+    "CHUNK": lambda a: (
+        min(a["N"], 2048 if 32 < a["M"] <= 128 else 4096) if _topk_profile(a) else a["CHUNK"]
+    ),
+    "W1": lambda a: (2 if 32 < a["M"] <= 128 else 4) if _topk_profile(a) else 4,
+    "W2": lambda a: 4,
+    "S1": lambda a: (1 if a["M"] > 128 else 3) if _topk_profile(a) else 3,
+    "S2": lambda a: (1 if a["M"] > 128 else 3) if _topk_profile(a) else 3,
+}
+HEURISTICS_CONFIGS["mean_inner"] = {
+    "TILE_N": _mean_tile,
+    "ONE_TILE_PER_CTA": softmax_heur_one_tile_per_cta,
+    "num_warps": _mean_warps,
+    "num_stages": lambda a: 1 if _mean_profile(a) else 3,
+}
+HEURISTICS_CONFIGS["mean_vec_launch"] = {
+    "BLOCK_SIZE_K": lambda a: 128 if _mean_vec_profile(a) else a["BLOCK_SIZE_K"],
+    "VEC_SIZE": lambda a: (
+        (1 if a["M"] < 32 else 4) if _mean_vec_profile(a) else a["VEC_SIZE"]
+    ),
+    "num_warps": lambda a: (
+        (2 if a["M"] < 32 else 1) if _mean_vec_profile(a) else a["num_warps"]
+    ),
+    "num_stages": lambda a: 1 if _mean_vec_profile(a) else 3,
+}
