@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 FlagOS Contributors
+
+"""Small-M local Linear kernels. FP32 products/accumulation; TF32 never enabled."""
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def linear_gemv(
+    X,
+    W,
+    Y,
+    M: tl.constexpr,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+):
+    mi = tl.program_id(0) * BM + tl.arange(0, BM)
+    ni = tl.program_id(1) * BN + tl.arange(0, BN)
+    ki = tl.arange(0, BK)
+    acc = tl.zeros((BM, BN), tl.float32)
+    for start in range(tl.cdiv(K, BK)):
+        k = start * BK + ki
+        a = tl.load(
+            X + mi[:, None] * K + k[None, :],
+            (mi[:, None] < M) & (k[None, :] < K),
+            other=0,
+        ).to(tl.float32)
+        b = tl.load(
+            W + ni[:, None] * K + k[None, :],
+            (ni[:, None] < N) & (k[None, :] < K),
+            other=0,
+        ).to(tl.float32)
+        products = a[:, None, :] * b[None, :, :]
+        acc += tl.sum(products, axis=2)
+    tl.store(
+        Y + mi[:, None] * N + ni[None, :],
+        acc.to(Y.dtype.element_ty),
+        (mi[:, None] < M) & (ni[None, :] < N),
+    )
