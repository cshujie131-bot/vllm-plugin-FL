index 0000000..7c264cf
--- /dev/null
+++ b/src/flaggems_vllm/ops/minimax_m3/index_score.py
@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 FlagOS Contributors
+
+"""Experimental M3 H1/D128 block scores. TopK selection is deliberately separate.
+
+Vector scoring removes the Q1->Q64 matrix padding. Dot variants split independent
+KV pages without splitting the head-dimension reduction. Nothing installs itself.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+LAST_KERNELS = []
+
+
+@triton.jit
+def index_vector_kernel(
+    Q,
+    IK,
+    BT,
+    CU,
+    LENS,
+    PREFIX,
+    S,
+    QN: tl.constexpr,
+    QD: tl.constexpr,
+    KB: tl.constexpr,
+    KN: tl.constexpr,
+    KD: tl.constexpr,
+    BS: tl.constexpr,
+    SN: tl.constexpr,
+    SK: tl.constexpr,
+    CHUNKS: tl.constexpr,
+    KTILE: tl.constexpr,
+    D: tl.constexpr = 128,
+):
+    req = tl.program_id(0)
+    chunk = tl.program_id(1)
+    start = tl.load(CU + req)
+    qlen = tl.load(CU + req + 1) - start
+    if qlen == 0:
+        return
+    seq = tl.load(LENS + req)
+    prefix = tl.load(PREFIX + req)
+    visible = tl.minimum(seq, prefix + 1)
+    pages = tl.cdiv(tl.maximum(visible, 0), 128)
+    per = tl.cdiv(pages, CHUNKS)
+    lo = chunk * per
+    hi = tl.minimum(lo + per, pages)
+    if lo >= hi:
+        return
+    dd = tl.arange(0, D)
+    kk = tl.arange(0, KTILE)
+    q = tl.load(Q + start * QN + dd * QD).to(tl.float32)
+    for blk in tl.range(lo, hi):
+        physical = tl.load(BT + req * BS + blk).to(tl.int64)
+        best = tl.full((), float("-inf"), tl.float32)
+        for sub in range(0, 128, KTILE):
+            k = tl.load(
+                IK + physical * KB + (sub + kk[:, None]) * KN + dd[None, :] * KD
+            ).to(tl.float32)
+            dots = tl.sum(k * q[None, :], 1)
+            dots = tl.where(blk * 128 + sub + kk < visible, dots, float("-inf"))
+            best = tl.maximum(best, tl.max(dots, 0))
+        tl.store(S + start * SN + blk * SK, best)
+
+
+@triton.jit
+def index_dot_kernel(
+    Q,
+    IK,
+    BT,
+    CU,
+    LENS,
+    PREFIX,
+    S,
+    QN: tl.constexpr,
+    QD: tl.constexpr,
+    KB: tl.constexpr,
+    KN: tl.constexpr,
+    KD: tl.constexpr,
+    BS: tl.constexpr,
+    SN: tl.constexpr,
+    SK: tl.constexpr,
+    BQ: tl.constexpr,
+    KTILE: tl.constexpr,
+    CHUNKS: tl.constexpr,
+    D: tl.constexpr = 128,
+):
+    qt = tl.program_id(0)
+    req = tl.program_id(1)
+    chunk = tl.program_id(2)
+    start = tl.load(CU + req)
+    qlen = tl.load(CU + req + 1) - start
+    if qt * BQ >= qlen:
+        return
+    seq = tl.load(LENS + req)
+    prefix = tl.load(PREFIX + req)
+    qr = qt * BQ + tl.arange(0, BQ)
+    dd = tl.arange(0, D)
+    kk = tl.arange(0, KTILE)
+    visible = tl.minimum(seq, prefix + tl.minimum((qt + 1) * BQ, qlen))
+    pages = tl.cdiv(tl.maximum(visible, 0), 128)
+    per = tl.cdiv(pages, CHUNKS)
+    lo = chunk * per
+    hi = tl.minimum(lo + per, pages)
+    if lo >= hi:
+        return
+    q = tl.load(
+        Q + (start + qr[:, None]) * QN + dd[None, :] * QD,
+        mask=qr[:, None] < qlen,
+        other=0,
+    )
+    for blk in tl.range(lo, hi):
+        physical = tl.load(BT + req * BS + blk).to(tl.int64)
+        best = tl.full((BQ,), float("-inf"), tl.float32)
+        for sub in range(0, 128, KTILE):
+            k = tl.load(
+                IK + physical * KB + (sub + kk[None, :]) * KN + dd[:, None] * KD
+            )
+            dots = tl.dot(q, k)
+            pos = blk * 128 + sub + kk
+            # Like the reference, historical pages need no per-element causal mask.
+            if prefix + qt * BQ < blk * 128 + sub + KTILE:
+                dots = tl.where(
+                    pos[None, :] <= prefix + qr[:, None], dots, float("-inf")
+                )
+            best = tl.maximum(best, tl.max(dots, 1))
+        tl.store(S + (start + qr) * SN + blk * SK, best, mask=qr < qlen)
+
+
+def chunk_count(batch, qtiles, target=512, cap=64):
+    value = max(1, min(cap, target // max(1, batch * qtiles)))
+    return 1 << (value.bit_length() - 1)
+
+
+@torch.no_grad()
+def score(
+    idx_q,
+    index_kv_cache,
+    block_table,
+    cu_seqlens_q,
+    seq_lens,
+    prefix_lens,
+    max_query_len,
+    max_seq_len,
+    num_kv_heads,
+    *,
+    mode="vector",
+    bq=16,
+    ktile=128,
+    chunks=None,
+    warps=4,
+    stages=1,
+    collect=False,
+):
+    assert idx_q.shape[1:] == (1, 128) and num_kv_heads == 1
+    assert idx_q.dtype == index_kv_cache.dtype == torch.bfloat16
+    assert index_kv_cache.shape[1:] == (128, 128)
+    assert ktile in (32, 64, 128)
+    batch = cu_seqlens_q.numel() - 1
+    stride = triton.cdiv(triton.cdiv(max_seq_len, 128), 16) * 16
+    out = torch.empty(
+        (1, idx_q.shape[0], stride), dtype=torch.float32, device=idx_q.device
+    )
+    args = (
+        idx_q,
+        index_kv_cache,
+        block_table,
+        cu_seqlens_q,
+        seq_lens,
+        prefix_lens,
+        out,
+        idx_q.stride(0),
+        idx_q.stride(2),
+        *index_kv_cache.stride(),
+        block_table.stride(0),
+        out.stride(1),
+        out.stride(2),
+    )
+    if mode == "vector":
+        assert max_query_len == 1
+        splits = chunks or chunk_count(batch, 1)
+        k = index_vector_kernel[(batch, splits)](
+            *args, CHUNKS=splits, KTILE=ktile, num_warps=warps, num_stages=stages
+        )
+    elif mode == "dot":
+        assert bq in (16, 32, 64)
+        splits = chunks or chunk_count(batch, triton.cdiv(max_query_len, bq), cap=16)
+        k = index_dot_kernel[(triton.cdiv(max_query_len, bq), batch, splits)](
+            *args, BQ=bq, KTILE=ktile, CHUNKS=splits, num_warps=warps, num_stages=stages
+        )
+    else:
+        raise ValueError(mode)
+    if collect:
+        LAST_KERNELS.append(k)
+    return out
diff --git a/src/flaggems_vllm/ops/minimax_m3/long_decode.py b/src/flaggems_vllm/ops/minimax_m3/long_decode.py
new file mode 100644
index 0000000..9ae68e9
--- /dev/null
+++ b/src/flaggems_vllm/ops/minimax_m3/long_decode.py
@@ -0,0 +1,356 @@
+from .subtile_decode import (
+    _gqa_sparse_fwd_kernel,
+    _m3_attn_block_h,
+    _merge_topk_attn_out_kernel,
+    _sparse_attn_num_stages_kwarg,
+    minimax_m3_sparse_attn,
+)
+from .policy import get_policy as load
+
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Triton kernels for MiniMax M3 block-sparse GQA attention.
+
+The main heads attend only to the blocks selected by the lightning indexer (see
+``index_topk``). Adapted to vLLM's paged KV cache: the KV page size is forced to
+equal the sparse block size (128), so one selected block maps to exactly one
+page.
+
+Main K/V cache layout (vLLM):
+  ``(num_blocks, 2, 128, num_kv_heads, head_dim)``  K=[:,0] V=[:,1]
+
+Only the paths MiniMax M3 uses are implemented: no attention sink, base-2
+(exp2/log2) softmax. The decode kernels use split-K (flash-decoding) over the
+selected blocks with a separate merge step, since one query token per request
+leaves the prefill kernels (which parallelize over the query dim) idle.
+"""
+
+import os
+import torch
+
+import triton
+import triton.language as tl
+
+LAST_KERNELS = []
+COLLECT_METADATA = False
+WARPS = load().attention["base_decode"]["warps"]
+STAGES = 1
+SPLIT = None
+KTILE = 32
+PAGE_PARTS = 1
+
+# One sparse block == one KV page.
+SPARSE_BLOCK_SIZE = 128
+
+_FP8_DTYPES = (
+    torch.float8_e4m3fn,
+    torch.float8_e4m3fnuz,
+    torch.float8_e5m2,
+    torch.float8_e5m2fnuz,
+)
+
+
+_SPARSE_ATTN_NUM_STAGES_KWARG: dict | None = None
+
+
+# ---------------------------------------------------------------------------
+# GQA block-sparse attention (paged). Main heads attend only to the selected
+# blocks. BLOCK_SIZE_K == 128 so each selected block is one page.
+# ---------------------------------------------------------------------------
+# since prefill metadata is sliced from mixed batch metadata, seq_lens and prefix_lens
+# might lose pointer alignment, which trigger Triton recompiles. we don't actually
+# need pointer alignment for those tensors anyway because we do scalar load.
+
+
+# ---------------------------------------------------------------------------
+# Decode kernels (split-K). Decode batches are flattened request-major, with a
+# runtime query length used to map each query token back to its request metadata.
+# This parallelizes over the selected top-k blocks, producing partials that the
+# merge kernel combines (flash-decoding). All chunk counts depend only on shape
+# constants so the grid is fixed within a cuda graph. Base-2 (exp2/log2)
+# softmax matches the prefill kernel.
+# ---------------------------------------------------------------------------
+@triton.heuristics(
+    {
+        "BLOCK_SIZE_H": lambda args: max(
+            16, triton.next_power_of_2(args["gqa_group_size"])
+        ),
+        "BLOCK_SIZE_D": lambda args: triton.next_power_of_2(args["head_dim"]),
+        "BLOCK_SIZE_T": lambda args: triton.next_power_of_2(args["max_topk"]),
+    }
+)
+@triton.jit(do_not_specialize=["decode_query_len"])
+def _gqa_sparse_decode_kernel(
+    q_ptr,  # [total_q, num_heads, head_dim]
+    kv_cache_ptr,  # main cache: [num_blocks, 2, 128, num_kv_heads, head_dim]
+    t_ptr,  # topk_idx: [num_kv_heads, total_q, topk]
+    o_ptr,  # partial out: [NUM_TOPK_CHUNKS, total_q, num_heads, head_dim]
+    lse_ptr,  # partial lse (log2): [NUM_TOPK_CHUNKS, total_q, num_heads]
+    block_table_ptr,  # [num_reqs, max_blocks]
+    seq_lens,  # [num_reqs]
+    total_q,
+    gqa_group_size,
+    head_dim,
+    max_topk,
+    sm_scale,
+    decode_query_len,
+    stride_qn,
+    stride_qh,
+    stride_qd,
+    stride_kv_blk,
+    stride_kv_kv,
+    stride_kv_pos,
+    stride_kv_h,
+    stride_kv_d,
+    stride_th,
+    stride_tn,
+    stride_tk,
+    stride_o_c,
+    stride_o_b,
+    stride_o_h,
+    stride_o_d,
+    stride_l_c,
+    stride_l_b,
+    stride_l_h,
+    stride_bt_b,
+    BLOCK_SIZE_K: tl.constexpr,  # == SPARSE_BLOCK_SIZE (128)
+    NUM_TOPK_CHUNKS: tl.constexpr,
+    INNER_K: tl.constexpr,
+    PAGE_PARTS: tl.constexpr,
+    BLOCK_SIZE_H: tl.constexpr,
+    BLOCK_SIZE_D: tl.constexpr,
+    BLOCK_SIZE_T: tl.constexpr,
+    USE_FP8: tl.constexpr,  # fp8 KV cache: dequantize K/V to q.dtype on load
+    USE_PDL: tl.constexpr,
+):
+    sm_scale_log2e = sm_scale * 1.4426950409
+    # split-K over the topk dimension: pid(0) folds (query-token, chunk).
+    pid_bc, pid_kh = tl.program_id(0), tl.program_id(1)
+    pid_b = pid_bc % total_q
+    pid_c = pid_bc // total_q
+    req_id = pid_b // decode_query_len
+    q_offset = pid_b - req_id * decode_query_len
+    pid_h = pid_kh * gqa_group_size
+    logical_chunks = NUM_TOPK_CHUNKS // PAGE_PARTS
+    logical_c = pid_c // PAGE_PARTS
+    page_part = pid_c % PAGE_PARTS
+    page_offset = page_part * (BLOCK_SIZE_K // PAGE_PARTS)
+    chunk_size_topk = (max_topk + logical_chunks - 1) // logical_chunks
+    chunk_start_topk = logical_c * chunk_size_topk
+    chunk_end_compiletime = chunk_start_topk + chunk_size_topk
+
+    if USE_PDL:
+        tl.extra.cuda.gdc_wait()
+
+    seq_len = tl.load(seq_lens + req_id)
+    query_pos = seq_len - decode_query_len + q_offset
+    # Full-CG padding uses zero-length request rows. Clamp to an empty
+    # attention range instead of letting padded rows produce negative lengths.
+    kv_len = tl.maximum(query_pos + 1, 0)
+
+    # number of valid (non-padded) selected blocks for this query token
+    off_t = tl.arange(0, BLOCK_SIZE_T)
+    idx_base = t_ptr + pid_kh * stride_th + pid_b * stride_tn
+    topk_idx = tl.load(idx_base + off_t * stride_tk, mask=off_t < max_topk, other=-1)
+    real_topk = tl.sum((topk_idx >= 0).to(tl.int32), axis=0)
+    chunk_end_topk = tl.minimum(chunk_end_compiletime, real_topk)
+
+    off_n = tl.arange(0, INNER_K)
+    off_d = tl.arange(0, BLOCK_SIZE_D)
+    d_mask = off_d < head_dim
+    bt_row = block_table_ptr + req_id * stride_bt_b
+
+    m_i = tl.full((BLOCK_SIZE_H,), float("-inf"), dtype=tl.float32)
+    lse_i = tl.full((BLOCK_SIZE_H,), float("-inf"), dtype=tl.float32)
+    acc_o = tl.zeros((BLOCK_SIZE_H, BLOCK_SIZE_D), dtype=tl.float32)
+    q_ptrs = tl.make_block_ptr(
+        base=q_ptr + pid_b * stride_qn + pid_h * stride_qh,
+        shape=(gqa_group_size, head_dim),
+        strides=(stride_qh, stride_qd),
+        offsets=(0, 0),
+        block_shape=(BLOCK_SIZE_H, BLOCK_SIZE_D),
+        order=(1, 0),
+    )
+    q = tl.load(q_ptrs, boundary_check=(0, 1), padding_option="zero")
+
+    cur_idx_ptr = idx_base + chunk_start_topk * stride_tk
+    for _ in tl.range(chunk_start_topk, chunk_end_topk):
+        blk = tl.load(cur_idx_ptr).to(tl.int32)
+        cur_idx_ptr = cur_idx_ptr + stride_tk
+        c = blk * BLOCK_SIZE_K
+        page = tl.load(bt_row + blk).to(tl.int64)
+        for inner_sub in range(0, BLOCK_SIZE_K // PAGE_PARTS, INNER_K):
+            sub = page_offset + inner_sub
+            pos = c + sub + off_n
+            pos_mask = pos < kv_len
+            k = tl.load(
+                kv_cache_ptr
+                + page * stride_kv_blk
+                + 0 * stride_kv_kv
+                + (sub + off_n[None, :]) * stride_kv_pos
+                + pid_kh * stride_kv_h
+                + off_d[:, None] * stride_kv_d,
+                mask=d_mask[:, None] & pos_mask[None, :],
+                other=0.0,
+            )
+            if USE_FP8:
+                k = k.to(q.dtype)
+            qk = tl.zeros((BLOCK_SIZE_H, INNER_K), dtype=tl.float32)
+            qk += tl.where(pos_mask[None, :], 0, float("-inf"))
+            qk += tl.dot(q, k) * sm_scale_log2e
+            m_ij = tl.maximum(m_i, tl.max(qk, axis=1))
+            m_safe = tl.where(m_ij > float("-inf"), m_ij, 0.0)
+            p = tl.exp2(qk - m_safe[:, None])
+            l_ij = tl.sum(p, axis=1)
+            acc_o = acc_o * tl.exp2(m_i - m_safe)[:, None]
+            v = tl.load(
+                kv_cache_ptr
+                + page * stride_kv_blk
+                + 1 * stride_kv_kv
+                + (sub + off_n[:, None]) * stride_kv_pos
+                + pid_kh * stride_kv_h
+                + off_d[None, :] * stride_kv_d,
+                mask=pos_mask[:, None] & d_mask[None, :],
+                other=0.0,
+            )
+            if USE_FP8:
+                v = v.to(q.dtype)
+            acc_o += tl.dot(p.to(v.dtype), v)
+            m_i = m_ij
+            l_sum = tl.exp2(lse_i - m_safe) + l_ij
+            lse_i = tl.where(l_sum > 0, m_safe + tl.log2(l_sum), float("-inf"))
+    if USE_PDL:
+        tl.extra.cuda.gdc_launch_dependents()
+
+    # Empty chunks for active rows must store zero output; otherwise the merge
+    # can hit 0 * NaN. All-empty padded rows may still produce NaNs in merge.
+    scale = tl.where(lse_i > float("-inf"), tl.exp2(m_i - lse_i), tl.zeros_like(lse_i))
+    acc_o = acc_o * scale[:, None]
+    o_ptrs = tl.make_block_ptr(
+        base=o_ptr + pid_c * stride_o_c + pid_b * stride_o_b + pid_h * stride_o_h,
+        shape=(gqa_group_size, head_dim),
+        strides=(stride_o_h, stride_o_d),
+        offsets=(0, 0),
+        block_shape=(BLOCK_SIZE_H, BLOCK_SIZE_D),
+        order=(1, 0),
+    )
+    tl.store(o_ptrs, acc_o.to(o_ptr.dtype.element_ty), boundary_check=(0, 1))
+    lse_ptrs = tl.make_block_ptr(
+        base=lse_ptr + pid_c * stride_l_c + pid_b * stride_l_b + pid_h * stride_l_h,
+        shape=(gqa_group_size,),
+        strides=(stride_l_h,),
+        offsets=(0,),
+        block_shape=(BLOCK_SIZE_H,),
+        order=(0,),
+    )
+    tl.store(lse_ptrs, lse_i.to(lse_ptr.dtype.element_ty), boundary_check=(0,))
+
+
+# ---------------------------------------------------------------------------
+# Python wrappers
+# ---------------------------------------------------------------------------
+
+
+@torch.no_grad()
+def minimax_m3_sparse_attn_decode(
+    q: torch.Tensor,  # [total_q, num_heads, head_dim]
+    kv_cache: torch.Tensor,  # [num_blocks, 2, 128, num_kv_heads, head_dim]
+    topk_idx: torch.Tensor,  # [num_kv_heads, total_q, topk]
+    block_table: torch.Tensor,  # [num_reqs, max_blocks]
+    seq_lens: torch.Tensor,  # [num_reqs] int32
+    num_kv_heads: int,
+    sm_scale: float,
+    output: torch.Tensor,  # [total_q, num_heads, head_dim]
+    decode_query_len: int,
+) -> None:
+    """GQA block-sparse attention for decode (split-K over the top-k blocks)."""
+    total_q, num_heads, head_dim = q.shape
+    assert total_q == seq_lens.shape[0] * decode_query_len
+    max_topk = topk_idx.shape[-1]
+    gqa_group_size = num_heads // num_kv_heads
+    use_fp8 = kv_cache.dtype in _FP8_DTYPES
+    use_pdl = False
+    # `launch_pdl` is a Triton runtime kwarg only some backends accept (CUDA
+    # SM9+); this ROCm Triton rejects it even when False ("Keyword argument
+    # launch_pdl was specified but unrecognised"). Only pass it when PDL is
+    # actually supported -- on ROCm use_pdl is always False, so it's omitted.
+    pdl_launch = {"launch_pdl": True} if use_pdl else {}
+    # split-K over the selected blocks; chunk count is shape-constant (cuda graph).
+    TARGET_GRID = 256
+    target = max(1, min(max_topk, TARGET_GRID // max(1, total_q * num_kv_heads)))
+    num_topk_chunks = (SPLIT or (1 << (target.bit_length() - 1))) * PAGE_PARTS
+    o_partial = torch.empty(
+        num_topk_chunks, total_q, num_heads, head_dim, dtype=q.dtype, device=q.device
+    )
+    lse_partial = torch.empty(
+        num_topk_chunks, total_q, num_heads, dtype=torch.float32, device=q.device
+    )
+    grid = (total_q * num_topk_chunks, num_kv_heads)
+    compiled = _gqa_sparse_decode_kernel[grid](
+        q,
+        kv_cache,
+        topk_idx,
+        o_partial,
+        lse_partial,
+        block_table,
+        seq_lens,
+        total_q,
+        gqa_group_size,
+        head_dim,
+        max_topk,
+        sm_scale,
+        decode_query_len,
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        kv_cache.stride(0),
+        kv_cache.stride(1),
+        kv_cache.stride(2),
+        kv_cache.stride(3),
+        kv_cache.stride(4),
+        topk_idx.stride(0),
+        topk_idx.stride(1),
+        topk_idx.stride(2),
+        o_partial.stride(0),
+        o_partial.stride(1),
+        o_partial.stride(2),
+        o_partial.stride(3),
+        lse_partial.stride(0),
+        lse_partial.stride(1),
+        lse_partial.stride(2),
+        block_table.stride(0),
+        BLOCK_SIZE_K=SPARSE_BLOCK_SIZE,
+        NUM_TOPK_CHUNKS=num_topk_chunks,
+        INNER_K=KTILE,
+        PAGE_PARTS=PAGE_PARTS,
+        USE_FP8=use_fp8,
+        USE_PDL=use_pdl,
+        num_warps=WARPS,
+        num_stages=STAGES,
+        **pdl_launch,
+    )
+    if COLLECT_METADATA:
+        LAST_KERNELS.append(compiled)
+    merge_grid = (total_q, num_heads)
+    compiled = _merge_topk_attn_out_kernel[merge_grid](
+        o_partial,
+        lse_partial,
+        output,
+        head_dim,
+        o_partial.stride(0),
+        o_partial.stride(1),
+        o_partial.stride(2),
+        o_partial.stride(3),
+        lse_partial.stride(0),
+        lse_partial.stride(1),
+        lse_partial.stride(2),
+        output.stride(0),
+        output.stride(1),
+        output.stride(2),
+        NUM_TOPK_CHUNKS=num_topk_chunks,
+        USE_PDL=use_pdl,
+        **pdl_launch,
+    )
+
+    if COLLECT_METADATA:
+        LAST_KERNELS.append(compiled)
