+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 FlagOS Contributors
+
+"""Explicit immutable kernel launch parameters; no framework or TP discovery."""
+
+from dataclasses import dataclass
+from types import MappingProxyType
+
+
+@dataclass(frozen=True)
+class KernelPolicy:
+    safe_topk: bool = True
+    safe_head_tile: bool = True
+    safe_stages: bool = True
+    moe_alignment_tle: bool = False
+
+
+@dataclass(frozen=True)
+class LaunchPolicy:
+    kernels: KernelPolicy
+    attention: object
+
+
+def _freeze(value):
+    return MappingProxyType(
+        {k: _freeze(v) if isinstance(v, dict) else v for k, v in value.items()}
+    )
+
+
+_DEFAULT = {
+    "base_prefill": {"qpack": 8, "ktile": 32, "warps": 2, "stages": 1},
+    "base_decode": {"ktile": 32, "warps": 2, "stages": 1, "split": None},
+}
+_POLICY = LaunchPolicy(KernelPolicy(), _freeze(_DEFAULT))
+_SEALED = False
+
+
+def configure(kernels, attention):
+    """Set caller-provided launch parameters before decorators are evaluated."""
+    global _POLICY
+    if set(kernels) != set(KernelPolicy.__dataclass_fields__):
+        raise ValueError("Incomplete M3 kernel contract")
+    if any(type(v) is not bool for v in kernels.values()):
+        raise TypeError("Kernel correctness settings must be bool")
+    contract = KernelPolicy(**kernels)
+    if contract != KernelPolicy():
+        raise ValueError(
+            "Only the validated rounding/top-k/align contract is supported"
+        )
+    selected = {k: dict(attention[k]) for k in _DEFAULT}
+    for group, values in selected.items():
+        if set(values) != set(_DEFAULT[group]):
+            raise ValueError("Incomplete launch parameters: " + group)
+        for name, value in values.items():
+            if name == "split" and value is None:
+                continue
+            if type(value) is not int or value <= 0:
+                raise TypeError("Launch parameters must be positive integers")
+    new = LaunchPolicy(contract, _freeze(selected))
+    if _SEALED and new != _POLICY:
+        raise RuntimeError("Kernel parameters were already captured at import")
+    _POLICY = new
+
+
+def get_policy():
+    global _SEALED
+    _SEALED = True
+    return _POLICY
