+        ids=tl.load(I+t*TOPK+ki,ki<topk_len,other=-1)
+        valid=(ids<SKV)&(ids>=0)
+        ids=tl.where(valid,ids,0)
+        kp=KV+d[:,None]+ids[None,:]*512
+        kv0=tl.load(kp,cache_modifier=".cg")
+        kv1=tl.load(kp+256,cache_modifier=".cg")
