+@triton.jit
+def qk_states(Q,KV,I,SINK,LENS,P,A,F,MAX,LSE,
+              SQ,SKV,TOPK:tl.constexpr,NC:tl.constexpr,
+              SINK_ON:tl.constexpr,LEN_ON:tl.constexpr,SCALE:tl.constexpr):
