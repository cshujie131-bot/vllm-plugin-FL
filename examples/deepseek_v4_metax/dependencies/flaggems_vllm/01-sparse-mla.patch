+        scale1 = (scale1_u8.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+        scale2 = (scale2_u8.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+        scale3 = (scale3_u8.to(tl.int32) << 23).to(tl.float32, bitcast=True)
