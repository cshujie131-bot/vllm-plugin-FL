+        cm_03 *= inv_cs3
+        cm_10 *= inv_cs0
+        cm_11 *= inv_cs1
+        cm_12 *= inv_cs2
+        cm_13 *= inv_cs3
+        cm_20 *= inv_cs0
+        cm_21 *= inv_cs1
+        cm_22 *= inv_cs2
+        cm_23 *= inv_cs3
+        cm_30 *= inv_cs0
+        cm_31 *= inv_cs1
+        cm_32 *= inv_cs2
+        cm_33 *= inv_cs3
+    co = pid_n * 16
+    tl.store(comb_mix_ptr + co + 0, cm_00)
+    tl.store(comb_mix_ptr + co + 1, cm_01)
