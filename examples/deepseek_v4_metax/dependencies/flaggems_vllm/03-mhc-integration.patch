+            + tl.load(hc_base_ptr + 0)
+        )
+        + hc_pre_eps
+    )
+    pre_mix_1 = (
+        tl.sigmoid(
+            tl.load(gemm_out_ptr + go_base + 1) * rms_inv * scale_0
+            + tl.load(hc_base_ptr + 1)
+        )
+        + hc_pre_eps
+    )
+    pre_mix_2 = (
+        tl.sigmoid(
+            tl.load(gemm_out_ptr + go_base + 2) * rms_inv * scale_0
+            + tl.load(hc_base_ptr + 2)
+        )
