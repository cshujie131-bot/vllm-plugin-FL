+    )
+    pre_mix_3 = (
+        tl.sigmoid(
+            tl.load(gemm_out_ptr + go_base + 3) * rms_inv * scale_0
+            + tl.load(hc_base_ptr + 3)
+        )
+        + hc_pre_eps
+    )
+    post_0 = (
+        tl.sigmoid(
+            tl.load(gemm_out_ptr + go_base + 4) * rms_inv * scale_1
+            + tl.load(hc_base_ptr + 4)
+        )
+        * hc_post_mult_value
+    )
